
@page
@model CustodialTaskList.Pages.IndexModel

@{
    ViewData["Title"] = "Daily Cleaning Tasks";
}

<div class="container mt-4 kiosk-container">

    <div class="text-center mb-4">
        <h2>Custodial Task List</h2>
        <h5 id="currentDate" class="text-muted"></h5>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn btn-primary flex-fill"
                id="morningButton"
                onclick="loadTasks('Morning')">
            Morning
            <small class="d-block">6 AM - 2 PM</small>
        </button>

        <button class="btn btn-outline-primary flex-fill"
                id="eveningButton"
                onclick="loadTasks('Evening')">
            Evening
            <small class="d-block">2 PM - 10 PM</small>
        </button>
    </div>

    <div class="d-flex justify-content-between mb-3">
        <h4 id="shiftTitle">Morning Shift</h4>
        <span id="progressCounter"
              class="text-muted"></span>
    </div>

    <div id="taskList"></div>

</div>

<form id="securityTokenForm" method="post">
    @Html.AntiForgeryToken()
</form>

<!-- Employee Initials Popup -->
<div class="modal fade" id="initialsModal"
     tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Complete Cleaning Task
                </h5>
                <button class="btn-close"
                        type="button"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <h5 id="selectedTaskName"></h5>

                <label class="form-label">
                    Employee Initials
                </label>

                <input id="employeeInitials"
                       class="form-control form-control-lg text-center"
                       maxlength="4"
                       placeholder="Initials"
                       readonly />

                <div id="virtualKeyboard"
                     class="mt-3"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        type="button"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-success"
                        id="confirmButton"
                        type="button"
                        onclick="confirmCompletion()">
                    Confirm Completion
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tasks.js"
            asp-append-version="true"></script>
}
