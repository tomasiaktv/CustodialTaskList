
@page
@model CustodialTaskList.Pages.Admin.LoginModel

@{
    ViewData["Title"] = "Supervisor Login";
}

<div class="container mt-5" style="max-width:440px">
    <h2>Supervisor Login</h2>
    <p class="text-muted">
        Custodial Task List Administration
    </p>

    <form method="post" class="card p-4">
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <label asp-for="Password"
               class="form-label">Password</label>

        <input asp-for="Password"
               type="password"
               class="form-control admin-keyboard-input"
               autocomplete="current-password"
               required />

        <button type="submit"
                class="btn btn-primary w-100">
            Sign In
        </button>
    </form>
</div>